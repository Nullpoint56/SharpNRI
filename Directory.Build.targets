<Project>

  <!--
    Package dependencies between this repository's packages are exact ([v]), not NuGet's default
    minimum (v, meaning >= v). SharpNRI is compiled against one SharpNRI.Descs, and the enum
    constants of the descs are compiled into every caller: with a minimum, an application that also
    references a later SharpNRI.Descs (another NRI version, through another package) would run
    SharpNRI against it and misread every renumbered value. Likewise SharpNRI.Testing against
    SharpNRI. tools/ci checks the packed nuspecs (release.yml, pack).
  -->
  <Target Name="SharpNRIExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="!$([System.String]::Copy('%(_ProjectReferencesWithVersions.ProjectVersion)').StartsWith('['))">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
