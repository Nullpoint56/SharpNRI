<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpNRI - managed bindings over NRI (NVIDIA Render Interface).

    Pure managed: no native source in this repository beyond patches/, which are applied to the NRI
    submodule before tools/build-native.ps1 builds the library. See AGENTS.md.

    Layout:
      Native/     L0  generated by tools/generate-native.ps1 - DO NOT EDIT. Only NriApi.cs compiles
                      here; the rest compiles into SharpNRI.Descs (see ../NativeSplit.props).
      Interop/    L1  interface acquisition, result mapping, callbacks, UTF-8, pinning
      Core/       L2  device, queues, resources, pipelines, command recording
      Extensions/ L3  one opt-in acquisition per NRI extension
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeSplit.props" />

  <PropertyGroup>
    <RootNamespace>SharpNRI</RootNamespace>
    <PackageId>SharpNRI</PackageId>
    <Version>1.0.0-beta.1</Version>
    <Description>C# bindings over NRI (NVIDIA Render Interface): Vulkan and D3D12 through one API. Pure managed P/Invoke over a pinned NRI build. Windows x64, Linux x64 and macOS arm64 (Vulkan through MoltenVK). Alpha.</Description>
    <PackageTags>nri;vulkan;d3d12;rhi;graphics;rendering</PackageTags>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591;CS8981;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Native\**\*.cs" />
    <Compile Include="@(SharpNRIGeneratedImport)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\descs\SharpNRI.Descs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NriVersion" Value="$(NriVersion)" />
    <InternalsVisibleTo Include="SharpNRI.Tests" />
  </ItemGroup>

  <!--
    Native payload: the Base variant (no upscaler SDK, AGENTS.md: Native packages), staged by
    tools/build-native.ps1 into ../runtimes/<rid>/native. The Upscalers variant is the
    packaging project under ../native/.
    Packed under runtimes/<rid>/native for NuGet; the host RID's files are also copied flat next to
    a ProjectReference consumer's output. The two globs must stay disjoint: when they overlap, the package
    ships every RID except the one it was built on.
  -->
  <PropertyGroup>
    <SharpNRIRid Condition="'$(SharpNRIRid)' == ''">$(RuntimeIdentifier)</SharpNRIRid>
    <SharpNRIRid Condition="'$(SharpNRIRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</SharpNRIRid>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(SharpNRIRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="true"
             PackagePath="runtimes\$(SharpNRIRid)\native\%(RecursiveDir)%(Filename)%(Extension)"
             Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\**\*"
          Exclude="$(MSBuildThisFileDirectory)..\runtimes\$(SharpNRIRid)\native\**\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!--
    Repository convenience only, never packed: when tools/build-native.ps1 has staged the Agility
    runtime (runtimes-agility/<rid>/native/AgilitySDK), copy it beside ProjectReference consumers
    too, so the in-repo tests run D3D12 on the Agility SDK as an application that copies Microsoft's
    Microsoft.Direct3D.D3D12 package into AgilitySDK/ would (docs/guide.md: Agility SDK).
    -p:SharpNRIDevAgility=false runs them on the inbox runtime.
    The NuGet package carries Base only (AGENTS.md: Native packages).
  -->
  <ItemGroup Condition="'$(SharpNRIDevAgility)' != 'false'">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes-agility\$(SharpNRIRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="false"
             Visible="false" />
  </ItemGroup>

  <!--
    The native library is built, never committed (AGENTS.md: Native packages). Without it a build
    from source succeeds and the first device creation fails with a DllNotFoundException in the
    consumer, far from the cause; so the build stops here instead, naming the file and the command.
    Packages are unaffected: they carry the payload. -p:SharpNRIRequireNative=false builds anyway
    (managed-only work on a RID without a payload).
  -->
  <PropertyGroup>
    <SharpNRINativeDir>$(MSBuildThisFileDirectory)..\runtimes\$(SharpNRIRid)\native\</SharpNRINativeDir>
  </PropertyGroup>

  <Target Name="SharpNRIRequireNative" BeforeTargets="Build"
          Condition="'$(SharpNRIRequireNative)' != 'false'
                     and !Exists('$(SharpNRINativeDir)NRI.dll')
                     and !Exists('$(SharpNRINativeDir)libNRI.so')
                     and !Exists('$(SharpNRINativeDir)libNRI.dylib')">
    <Error Code="SHARPNRI001"
           Text="The NRI native library for '$(SharpNRIRid)' is not built: $([System.IO.Path]::GetFullPath('$(SharpNRINativeDir)')) has no NRI.dll, libNRI.so or libNRI.dylib. In the SharpNRI checkout run: git submodule update --init, then pwsh tools/build-native.ps1 -Rid $(SharpNRIRid). (-p:SharpNRIRequireNative=false skips this check.)" />
  </Target>

</Project>
