<Project>

  <!--
    SharpNRI: the licences of what the native NRI library contains (NRI, VMA, D3D12MA, NVAPI, AGS,
    Vulkan-Headers, NVTX, the Agility SDK headers) and THIRD-PARTY-NOTICES.md, copied beside the
    application to licenses\SharpNRI\<rid>\, folders kept: an application that ships NRI's library
    ships its notices. A RID-specific build or publish gets its RID's, a portable one every packed RID's.
    The package keeps them out of runtimes/<rid>/native/, which NuGet copies flat.

      SharpNRICopyLicenses   false copies none (the application handles the notices itself)
  -->

  <!--
    SharpNRI depends on exactly one SharpNRI.Descs (SharpNRIDescsDependency, SharpNRI.props). A direct
    reference to another version wins the restore with only the warning NU1608, and device creation
    would then refuse it (INVALID_SDK): fail the build instead (SHARPNRI005).
  -->
  <PropertyGroup>
    <_SharpNRIAssets Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_SharpNRIAssets>
    <_SharpNRIDescsResolved>$([System.Text.RegularExpressions.Regex]::Match($(_SharpNRIAssets), '"(?i:sharpnri\.descs)/([^"]+)"').Groups[1].Value)</_SharpNRIDescsResolved>
  </PropertyGroup>

  <Target Name="SharpNRIDescsCheck" BeforeTargets="Build"
          Condition="'$(SharpNRIDescsDependency)' != '' and '$(_SharpNRIDescsResolved)' != '' and '$(_SharpNRIDescsResolved)' != '$(SharpNRIDescsDependency)'">
    <Error Code="SHARPNRI005"
           Text="SharpNRI $(SharpNRIPackedVersion) depends on SharpNRI.Descs $(SharpNRIDescsDependency) exactly, and this project restores SharpNRI.Descs $(_SharpNRIDescsResolved) (NU1608). Device creation would refuse it with INVALID_SDK: reference SharpNRI.Descs $(SharpNRIDescsDependency), or drop the direct reference." />
  </Target>

  <ItemGroup Condition="'$(SharpNRICopyLicenses)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)..\licenses\**\*" Condition="'$(RuntimeIdentifier)' == ''"
          Link="licenses\SharpNRI\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\licenses\$(RuntimeIdentifier)\**\*" Condition="'$(RuntimeIdentifier)' != ''"
          Link="licenses\SharpNRI\$(RuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>
