<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PrismNRI - managed bindings over NRI (NVIDIA Render Interface).

    Pure managed: no native source in this repository beyond patches/, which are applied to the NRI
    submodule before tools/build-native.ps1 builds the library. See CLAUDE.md.

    Layout:
      Native/     L0  generated by tools/generate-native.ps1 - DO NOT EDIT. Only NriApi.cs compiles
                      here; the rest compiles into PrismNRI.Descs (see ../NativeSplit.props).
      Interop/    L1  interface acquisition, result mapping, callbacks, UTF-8, pinning
      Core/       L2  device, queues, resources, pipelines, command recording
      Extensions/ L3  one opt-in acquisition per NRI extension
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeSplit.props" />

  <PropertyGroup>
    <RootNamespace>PrismNRI</RootNamespace>
    <PackageId>PrismNRI</PackageId>
    <Version>0.4.0-alpha</Version>
    <Description>C# bindings over NRI (NVIDIA Render Interface): Vulkan and D3D12 through one API. Pure managed P/Invoke over a pinned NRI build. Windows x64, Linux x64 and macOS arm64 (Vulkan through MoltenVK). Alpha.</Description>
    <PackageTags>nri;vulkan;d3d12;rhi;graphics;rendering</PackageTags>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591;CS8981;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Native\**\*.cs" />
    <Compile Include="@(PrismNRIGeneratedImport)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\descs\PrismNRI.Descs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NriVersion" Value="$(NriVersion)" />
    <InternalsVisibleTo Include="PrismNRI.Tests" />
  </ItemGroup>

  <!--
    Native payload: the Base variant (no upscaler SDK, CLAUDE.md: Native packages), staged by
    tools/build-native.ps1 into ../runtimes/<rid>/native. The Upscalers and Agility variants are
    the packaging projects under ../native/.
    Packed under runtimes/<rid>/native for NuGet; the host RID's files are also copied flat next to
    a ProjectReference consumer's output. The two globs must stay disjoint: when they overlap, the package
    ships every RID except the one it was built on.
  -->
  <PropertyGroup>
    <PrismNRIRid Condition="'$(PrismNRIRid)' == ''">$(RuntimeIdentifier)</PrismNRIRid>
    <PrismNRIRid Condition="'$(PrismNRIRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</PrismNRIRid>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(PrismNRIRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="true"
             PackagePath="runtimes\$(PrismNRIRid)\native\%(RecursiveDir)%(Filename)%(Extension)"
             Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\**\*"
          Exclude="$(MSBuildThisFileDirectory)..\runtimes\$(PrismNRIRid)\native\**\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!--
    Repository convenience only, never packed: when tools/build-native.ps1 has staged the Agility
    package (runtimes-agility/<rid>/native/AgilitySDK), copy it beside ProjectReference consumers
    too, so the in-repo tests run D3D12 on the Agility SDK as an application with the
    PrismNRI.Native.Agility package would. -p:PrismNRIDevAgility=false runs them on the inbox runtime.
    The NuGet package carries Base only (CLAUDE.md: Native packages).
  -->
  <ItemGroup Condition="'$(PrismNRIDevAgility)' != 'false'">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes-agility\$(PrismNRIRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="false"
             Visible="false" />
  </ItemGroup>

  <!--
    The native library is built, never committed (CLAUDE.md: Native packages). Without it a build
    from source succeeds and the first device creation fails with a DllNotFoundException in the
    consumer, far from the cause; so the build stops here instead, naming the file and the command.
    Packages are unaffected: they carry the payload. -p:PrismNRIRequireNative=false builds anyway
    (managed-only work on a RID without a payload).
  -->
  <PropertyGroup>
    <PrismNRINativeDir>$(MSBuildThisFileDirectory)..\runtimes\$(PrismNRIRid)\native\</PrismNRINativeDir>
  </PropertyGroup>

  <Target Name="PrismNRIRequireNative" BeforeTargets="Build"
          Condition="'$(PrismNRIRequireNative)' != 'false'
                     and !Exists('$(PrismNRINativeDir)NRI.dll')
                     and !Exists('$(PrismNRINativeDir)libNRI.so')
                     and !Exists('$(PrismNRINativeDir)libNRI.dylib')">
    <Error Code="PRISMNRI001"
           Text="The NRI native library for '$(PrismNRIRid)' is not built: $([System.IO.Path]::GetFullPath('$(PrismNRINativeDir)')) has no NRI.dll, libNRI.so or libNRI.dylib. In the PrismNRI checkout run: git submodule update --init, then pwsh tools/build-native.ps1 -Rid $(PrismNRIRid). (-p:PrismNRIRequireNative=false skips this check.)" />
  </Target>

</Project>
