<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Package consumption smoke test: the released .nupkg files as an outside project sees them,
    through PackageReference, runtimes/<rid>/native and deps.json, not the repository's
    ProjectReference copy. Not in PrismNRI.slnx. Run by the release workflow's consume job.

      dotnet run -c Release -p:PrismNRIPackageVersion=0.2.0-alpha
      PRISMNRI_FEED=<dir with the .nupkg files>   (default: ../../nupkg, see nuget.config)

    Packages restore into obj/packages, never the global cache, so a stale PrismNRI of the same
    version cannot stand in for the feed's.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <!-- PRISMNRI_FEED / -p:PrismNRIFeed replaces nuget.config's `local` folder. -->
  <PropertyGroup Condition="'$(PrismNRIFeed)' == ''">
    <PrismNRIFeed>$(PRISMNRI_FEED)</PrismNRIFeed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PrismNRIFeed)' != ''">
    <RestoreSources>$([MSBuild]::NormalizeDirectory('$(MSBuildStartupDirectory)', '$(PrismNRIFeed)'));https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PrismNRI" Version="$(PrismNRIPackageVersion)" />
    <PackageReference Include="PrismNRI.Testing" Version="$(PrismNRIPackageVersion)" />
  </ItemGroup>

  <Target Name="PrismNRIRequireVersion" BeforeTargets="_GenerateRestoreProjectSpec;Restore;CollectPackageReferences" Condition="'$(PrismNRIPackageVersion)' == ''">
    <Error Text="Pass the package version: -p:PrismNRIPackageVersion=&lt;Version&gt; (dotnet/PrismNRI.csproj)." />
  </Target>

  <!-- Which source the restored PrismNRI came from, as NuGet recorded it. -->
  <Target Name="PrismNRIPrintSource" BeforeTargets="Build">
    <PropertyGroup>
      <_PrismNRIMetadata>$(RestorePackagesPath)/prismnri/$(PrismNRIPackageVersion.ToLowerInvariant())/.nupkg.metadata</_PrismNRIMetadata>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PrismNRIMetadata)')" Text="PrismNRI $(PrismNRIPackageVersion) was not restored into $(RestorePackagesPath)" />
    <Message Importance="high" Text="PrismNRI $(PrismNRIPackageVersion) restored from: $([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_PrismNRIMetadata)')), '&quot;source&quot;:\s*&quot;([^&quot;]*)&quot;').Groups[1].Value.Replace('\\', '\'))" />
  </Target>

</Project>
