<?xml version="1.0" encoding="utf-8"?>
<!--
  The smoke consumer's sources: the folder feed with the .nupkg files, and nuget.org for anything
  else. `local` defaults to the repository's nupkg/ (relative to this file); PRISMNRI_FEED or
  -p:PrismNRIFeed=<dir> replaces it (PrismNRI.Consume.csproj), and the build prints which source
  the restored PrismNRI came from.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
