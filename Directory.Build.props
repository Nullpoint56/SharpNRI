<Project>

  <!--
    Single source of truth for the pinned NRI release.

    NRI is integer-versioned with breaking changes between versions and an ABI that is not stable
    upstream (AGENTS.md: The repository). This is an exact pin, not a floor. Everything downstream reads it
    from here:

      nri/                        the submodule, checked out at tag v$(NriVersion)
      tools/generate-native.ps1   the headers the L0 layer is generated from
      tools/build-native.ps1      the tag the native library is built from
      dotnet/SharpNRI.csproj      package metadata and the AssemblyMetadata the runtime check reads
      tests/                      the DeviceDesc.nriVersion a created device must report

    Bumping NRI is therefore: move the submodule, change this line, re-run both tools, rebase
    patches/, run the tests, review the diff.
  -->

  <PropertyGroup>
    <NriVersion>191</NriVersion>
    <!--
      Package versions (AGENTS.md: Versions). Every package has the NRI version as its major,
      $(NriVersion).<binding>.<patch>[-beta.N] (owner, 2026-11-07, from 191.0.0-beta.4): NRI breaks between
      versions and the binding's API is NRI's, so a new NRI version is a new major, and a package's
      version names the NRI it was built for. Within one NRI version a breaking change of the binding
      moves the second number, a fix the third. A build fails when a major is not $(NriVersion) (SHARPNRI004).
      SharpNRIVersion is the release: the tag v$(SharpNRIVersion) and the version of SharpNRI,
      SharpNRI.Testing, SharpNRI.Native.Upscalers and SharpNRI.AgilitySDK. SharpNRI.Descs moves only when
      its assembly changes: a binding-only release leaves it, and with it everything built on the descs,
      where it was. tools/ci/descs-version.ps1 fails when the descs changed since the published version.
    -->
    <SharpNRIVersion>191.0.0-beta.4</SharpNRIVersion>
    <SharpNRIDescsVersion>191.0.0-beta.1</SharpNRIDescsVersion>
    <!-- The Agility SDK NRI's CMake pins (NRI_AGILITY_SDK_VERSION_MAJOR / _MINOR), as its Microsoft.Direct3D.D3D12 version; build-native.ps1 refuses a mismatch -->
    <AgilitySdkVersion>1.620.1</AgilitySdkVersion>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>szombathy-tamas</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Nullpoint56/SharpNRI</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Nullpoint56/SharpNRI</PackageProjectUrl>
    <!-- One package page text for all four packages, with absolute links (nuget.org shows it) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Lint: the SDK's own analyzers (CA rules) and code-style rules, configured in .editorconfig and
      reported by every build; the CI lint job builds with warnings as errors (AGENTS.md: Lint).
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML docs ship in the packages (IntelliSense) and let the build check unused usings (IDE0005); a member without a comment is not an error (CS1591), a malformed comment is -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Debugging into the binding from an application: the package records the repository and the
      commit it was built from, each PDB ships beside its DLL, and Source Link (in the SDK) maps the
      PDB's documents to that commit on GitHub. The release pack adds ContinuousIntegrationBuild
      (deterministic, repository-relative paths); local and test builds keep their real paths.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- docs/nuget/README.md as packed: its blob/master links pointed at the release tag (Directory.Build.targets) -->
    <None Include="$(BaseIntermediateOutputPath)nuget-readme/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
