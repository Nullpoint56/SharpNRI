Validation: the draw parameters emulation record layout applies to D3D12 and Metal only.

"ENABLE_DRAW_PARAMETERS_EMULATION" is "D3D12, METAL" (NRIDescs.h), and only those backends emulate:
on SPIR-V NRI.hlsl writes plain "DrawDesc" / "DrawIndexedDesc" records, and the VK backend reads
them at "offset" and "stride" (CommandBufferVK.hpp:2215). CommandBufferVal::DrawIndirect and
DrawIndexedIndirect demanded the emulated "DrawBaseDesc" / "DrawIndexedBaseDesc" stride on every
backend (CommandBufferVal.hpp:1033, :1053), so a layout with the flag, as portable code sets it, made
validation refuse the correct VK records ("'stride' is too small, expected >= 24", 28 indexed), and
"Draw(Indexed)BaseDesc" records that passed it drew from the wrong words.

IsDrawParametersEmulationEnabled now also asks for a D3D12 or Metal device, as DeviceVal does for the
D3D12 setting it passes on (DeviceVal.hpp:638).

Measured on main 7ea93bb5, NVIDIA RTX 4070 SUPER, VK, a layout with the flag: DrawIndirect at stride 16
and DrawIndexedIndirect at stride 20 are refused without the patch; with it they draw the
baseVertex / baseInstance the vertex shader reads through the built-ins, the same picture as without
the flag. D3D12 (emulated, DrawBaseDesc records) is unchanged.

diff --git a/Source/Validation/CommandBufferVal.hpp b/Source/Validation/CommandBufferVal.hpp
index d2ebd851..d548f303 100644
--- a/Source/Validation/CommandBufferVal.hpp
+++ b/Source/Validation/CommandBufferVal.hpp
@@ -108,8 +108,11 @@ static inline bool IsTextureLayoutSupported(const TextureDesc& textureDesc, Layo
     return true;
 }
 
-static inline bool IsDrawParametersEmulationEnabled(const PipelineLayoutDesc& pipelineLayoutDesc) {
-    return (pipelineLayoutDesc.flags & PipelineLayoutBits::ENABLE_DRAW_PARAMETERS_EMULATION) != 0 && (pipelineLayoutDesc.shaderStages & StageBits::VERTEX_SHADER) != 0;
+static inline bool IsDrawParametersEmulationEnabled(GraphicsAPI graphicsAPI, const PipelineLayoutDesc& pipelineLayoutDesc) {
+    // D3D12, METAL: the other backends use native draw parameters, and their indirect records stay "Draw(Indexed)Desc"
+    bool isEmulated = graphicsAPI == GraphicsAPI::D3D12 || graphicsAPI == GraphicsAPI::METAL;
+
+    return isEmulated && (pipelineLayoutDesc.flags & PipelineLayoutBits::ENABLE_DRAW_PARAMETERS_EMULATION) != 0 && (pipelineLayoutDesc.shaderStages & StageBits::VERTEX_SHADER) != 0;
 }
 
 // Integer and stencil samples can't be averaged in any API
@@ -1030,7 +1033,7 @@ NRI_INLINE void CommandBufferVal::DrawIndirect(const Buffer& buffer, uint64_t of
     NRI_RETURN_ON_FAILURE(&m_Device, !countBuffer || deviceDesc.features.drawIndirectCount, ReturnVoid(), "'countBuffer' is not supported");
 
     const PipelineLayoutDesc& pipelineLayoutDesc = m_PipelineLayout->GetPipelineLayoutDesc();
-    bool enableDrawParametersEmulation = IsDrawParametersEmulationEnabled(pipelineLayoutDesc);
+    bool enableDrawParametersEmulation = IsDrawParametersEmulationEnabled(deviceDesc.graphicsAPI, pipelineLayoutDesc);
     uint32_t minStride = enableDrawParametersEmulation ? sizeof(DrawBaseDesc) : sizeof(DrawDesc);
     NRI_RETURN_ON_FAILURE(&m_Device, stride >= minStride, ReturnVoid(), "'stride' is too small, expected >= %u", minStride);
     NRI_RETURN_ON_FAILURE(&m_Device, (stride % 4) == 0, ReturnVoid(), "'stride' must be 4-byte aligned");
@@ -1050,7 +1053,7 @@ NRI_INLINE void CommandBufferVal::DrawIndexedIndirect(const Buffer& buffer, uint
     NRI_RETURN_ON_FAILURE(&m_Device, !countBuffer || deviceDesc.features.drawIndirectCount, ReturnVoid(), "'countBuffer' is not supported");
 
     const PipelineLayoutDesc& pipelineLayoutDesc = m_PipelineLayout->GetPipelineLayoutDesc();
-    bool enableDrawParametersEmulation = IsDrawParametersEmulationEnabled(pipelineLayoutDesc);
+    bool enableDrawParametersEmulation = IsDrawParametersEmulationEnabled(deviceDesc.graphicsAPI, pipelineLayoutDesc);
     uint32_t minStride = enableDrawParametersEmulation ? sizeof(DrawIndexedBaseDesc) : sizeof(DrawIndexedDesc);
     NRI_RETURN_ON_FAILURE(&m_Device, stride >= minStride, ReturnVoid(), "'stride' is too small, expected >= %u", minStride);
     NRI_RETURN_ON_FAILURE(&m_Device, (stride % 4) == 0, ReturnVoid(), "'stride' must be 4-byte aligned");
