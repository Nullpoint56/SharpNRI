Validation layer: pass the HAS_BUFFER sentinel through instead of dereferencing it.

NRIRayTracing.h defines HAS_BUFFER as (Buffer*)1 and says an AccelerationStructureDesc may use it
to indicate that a buffer will be present at build time without naming one. Both backends check for
it (BufferVK.h, BufferD3D12.h). The validation layer does not: ConvertBottomLevelGeometries runs
every geometry buffer through NRI_GET_IMPL, which calls GetImpl() on address 1 and crashes the
process with an access violation when enableNRIValidation is on. Measured on v190 from
CreateCommittedAccelerationStructure (docs/findings.md §7.5).

This patch makes the conversion return the sentinel unchanged. Nothing else changes. Applies on
top of NRI v190 with patches 0001 and 0002.

diff --git a/Source/Validation/ConversionVal.hpp b/Source/Validation/ConversionVal.hpp
index f5975d6..014ffb2 100644
--- a/Source/Validation/ConversionVal.hpp
+++ b/Source/Validation/ConversionVal.hpp
@@ -19,6 +19,13 @@ const char* nri::GetDescriptorTypeName(DescriptorType descriptorType) {
     return g_descriptorTypeNames[(uint32_t)descriptorType];
 }
 
+// PrismNRI patch 0003: "HAS_BUFFER" is a sentinel, not an object; it must reach the backend as is
+static inline Buffer* GetBufferImplOrSentinel(const Buffer* buffer) {
+    if (buffer == HAS_BUFFER)
+        return (Buffer*)HAS_BUFFER;
+    return NRI_GET_IMPL(Buffer, buffer);
+}
+
 void nri::ConvertBottomLevelGeometries(const BottomLevelGeometryDesc* geometries, uint32_t geometryNum, BottomLevelGeometryDesc*& outGeometries, BottomLevelTrianglesMicromapDesc*& outMicromaps) {
     for (uint32_t i = 0; i < geometryNum; i++) {
         const BottomLevelGeometryDesc& src = geometries[i];
@@ -27,18 +34,18 @@ void nri::ConvertBottomLevelGeometries(const BottomLevelGeometryDesc* geometries
         dst = src;
 
         if (src.type == BottomLevelGeometryType::TRIANGLES) {
-            dst.triangles.vertexBuffer = NRI_GET_IMPL(Buffer, src.triangles.vertexBuffer);
-            dst.triangles.indexBuffer = NRI_GET_IMPL(Buffer, src.triangles.indexBuffer);
-            dst.triangles.transformBuffer = NRI_GET_IMPL(Buffer, src.triangles.transformBuffer);
+            dst.triangles.vertexBuffer = GetBufferImplOrSentinel(src.triangles.vertexBuffer);
+            dst.triangles.indexBuffer = GetBufferImplOrSentinel(src.triangles.indexBuffer);
+            dst.triangles.transformBuffer = GetBufferImplOrSentinel(src.triangles.transformBuffer);
 
             if (src.triangles.micromap) {
                 dst.triangles.micromap = outMicromaps++;
 
                 *dst.triangles.micromap = *src.triangles.micromap;
                 dst.triangles.micromap->micromap = NRI_GET_IMPL(Micromap, src.triangles.micromap->micromap);
-                dst.triangles.micromap->indexBuffer = NRI_GET_IMPL(Buffer, src.triangles.micromap->indexBuffer);
+                dst.triangles.micromap->indexBuffer = GetBufferImplOrSentinel(src.triangles.micromap->indexBuffer);
             }
         } else
-            dst.aabbs.buffer = NRI_GET_IMPL(Buffer, src.aabbs.buffer);
+            dst.aabbs.buffer = GetBufferImplOrSentinel(src.aabbs.buffer);
     }
 }
