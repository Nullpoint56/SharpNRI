         out.srcQueueFamilyIndex = in.srcQueue == EXTERNAL_QUEUE ? VK_QUEUE_FAMILY_EXTERNAL : (in.srcQueue ? srcQueue->GetFamilyIndex() : VK_QUEUE_FAMILY_IGNORED);
         out.dstQueueFamilyIndex = in.dstQueue == EXTERNAL_QUEUE ? VK_QUEUE_FAMILY_EXTERNAL : (in.dstQueue ? dstQueue->GetFamilyIndex() : VK_QUEUE_FAMILY_IGNORED);
+
+        // A queue family ownership transfer is defined only for "EXCLUSIVE" images or to/from the external queue family
+        if (textureVK.IsConcurrent()) {
+            if (out.srcQueueFamilyIndex != VK_QUEUE_FAMILY_EXTERNAL)
+                out.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            if (out.dstQueueFamilyIndex != VK_QUEUE_FAMILY_EXTERNAL)
+                out.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        }
         out.image = textureVK.GetHandle();
