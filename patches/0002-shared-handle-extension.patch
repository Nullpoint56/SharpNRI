diff --git a/Source/D3D12/FenceD3D12.hpp b/Source/D3D12/FenceD3D12.hpp
index 2490319..3ead9d4 100644
--- a/Source/D3D12/FenceD3D12.hpp
+++ b/Source/D3D12/FenceD3D12.hpp
@@ -57,3 +57,37 @@ NRI_INLINE Result FenceD3D12::Wait(uint64_t value) {
 
     return Result::SUCCESS;
 }
+
+// PrismNRI patch 0002: shared handles
+
+Result FenceD3D12::Create(uint64_t initialValue, bool shared) {
+    if (!shared)
+        return Create(initialValue);
+
+    // D3D12 has no binary fences
+    if (initialValue == SWAPCHAIN_SEMAPHORE)
+        return Result::UNSUPPORTED;
+
+    HRESULT hr = m_Device->CreateFence(initialValue, D3D12_FENCE_FLAG_SHARED, IID_PPV_ARGS(&m_Fence));
+    NRI_RETURN_ON_BAD_HRESULT(&m_Device, hr, "ID3D12Device::CreateFence");
+
+    m_Event = CreateEventA(nullptr, FALSE, FALSE, nullptr);
+    m_IsShared = true;
+
+    return Result::SUCCESS;
+}
+
+Result FenceD3D12::GetSharedHandle(SharedHandle& sharedHandle) const {
+    sharedHandle = {};
+    if (!m_IsShared || !m_Fence)
+        return Result::INVALID_ARGUMENT;
+
+    HANDLE handle = nullptr;
+    HRESULT hr = m_Device->CreateSharedHandle(m_Fence.GetInterface(), nullptr, GENERIC_ALL, nullptr, &handle);
+    NRI_RETURN_ON_BAD_HRESULT(&m_Device, hr, "ID3D12Device::CreateSharedHandle");
+
+    sharedHandle.handle = handle;
+    sharedHandle.type = SharedHandleType::D3D12_FENCE;
+
+    return Result::SUCCESS;
+}
