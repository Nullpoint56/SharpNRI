+++ b/Include/Extensions/NRISharedHandle.h
@@ -0,0 +1,47 @@
+// © 2021 NVIDIA Corporation
+// PrismNRI patch 0002
+
+// Goal: exporting textures and fences to other APIs and processes (compositors, editors, interop)
+
+#pragma once
+
+#define NRI_SHARED_HANDLE_H 1
+
+NriNamespaceBegin
+
+// Marks a queue family ownership transfer to or from an external user of a shared texture (another device or process)
+// VK: "VK_QUEUE_FAMILY_EXTERNAL" when used as "TextureBarrierDesc::srcQueue" (acquire after import) or "dstQueue" (release before export)
+// D3D12: ignored (queue ownership does not exist)
+static const NriPtr(Queue) NriConstant(EXTERNAL_QUEUE) = (NriPtr(Queue))1;
+
+NriEnum(SharedHandleType, uint8_t,
+    NONE,
+    OPAQUE_WIN32,       // VK: "VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT" / "VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT" (NT handle)
+    OPAQUE_FD,          // VK: "VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT" / "VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT" (file descriptor)
+    D3D12_RESOURCE,     // D3D12: NT handle from "ID3D12Device::CreateSharedHandle" for an "ID3D12Resource" (openable via "ID3D12Device::OpenSharedHandle"; the resource is TYPELESS like every NRI texture, which "ID3D11Device1::OpenSharedResource1" refuses)
+    D3D12_FENCE         // D3D12: NT handle from "ID3D12Device::CreateSharedHandle" for an "ID3D12Fence" (openable via "ID3D12Device::OpenSharedHandle")
+);
+
+NriStruct(SharedHandle) {
+    void* handle;                   // NT handle (Windows) or file descriptor cast to a pointer (Linux); owned by the caller ("CloseHandle" / "close")
+    Nri(SharedHandleType) type;
+    uint64_t size;                  // VK: the allocation size, for "VkMemoryAllocateInfo::allocationSize" on import (0 on D3D12)
+    uint64_t offset;                // VK: the texture offset within the allocation, always 0 (dedicated)
+};
+
+// Threadsafe: yes
+NriStruct(SharedHandleInterface) {
+    // A committed texture with a dedicated, exportable allocation (VK: "VkExternalMemoryImageCreateInfo" + "VkExportMemoryAllocateInfo"; D3D12: "D3D12_HEAP_FLAG_SHARED")
+    Nri(Result)     (NRI_CALL *CreateSharedTexture)     (NriRef(Device) device, Nri(MemoryLocation) memoryLocation, float priority, const NriRef(TextureDesc) textureDesc, NriOut NriRef(Texture*) texture);
+
+    // A timeline fence that can be exported (VK: "VkExportSemaphoreCreateInfo"; D3D12: "D3D12_FENCE_FLAG_SHARED")
+    // VK only: "SWAPCHAIN_SEMAPHORE" initial value creates an exportable binary semaphore, which must be signaled once and then waited once
+    // before the next signal ("value" in "FenceSubmitDesc" is ignored, "GetFenceValue" and "Wait" must not be used). D3D12: "UNSUPPORTED"
+    Nri(Result)     (NRI_CALL *CreateSharedFence)       (NriRef(Device) device, uint64_t initialValue, NriOut NriRef(Fence*) fence);
+
+    // Every call creates a new handle, which the caller owns. "INVALID_ARGUMENT" if the object was not created shared
+    Nri(Result)     (NRI_CALL *GetTextureSharedHandle)  (const NriRef(Texture) texture, NriOut NriRef(SharedHandle) sharedHandle);
+    Nri(Result)     (NRI_CALL *GetFenceSharedHandle)    (const NriRef(Fence) fence, NriOut NriRef(SharedHandle) sharedHandle);
+};
+
+NriNamespaceEnd
