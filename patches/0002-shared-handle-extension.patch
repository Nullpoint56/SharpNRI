+
+// PrismNRI patch 0002: shared handles
+
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+#    define NRI_SHARED_MEMORY_HANDLE_TYPE VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT
+#else
+#    define NRI_SHARED_MEMORY_HANDLE_TYPE VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT
+#endif
+
+Result TextureVK::Create(const TextureDesc& textureDesc, MemoryLocation memoryLocation, float priority) {
+    m_Desc = FixTextureDesc(textureDesc);
+
+    VkExternalMemoryImageCreateInfo externalInfo = {VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+    externalInfo.handleTypes = NRI_SHARED_MEMORY_HANDLE_TYPE;
+
+    VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    m_Device.FillCreateInfo(m_Desc, info);
+    m_IsConcurrent = info.sharingMode == VK_SHARING_MODE_CONCURRENT;
+    externalInfo.pNext = info.pNext;
+    info.pNext = &externalInfo;
+
+    const auto& vk = m_Device.GetDispatchTable();
+    VkResult vkResult = vk.CreateImage(m_Device, &info, m_Device.GetVkAllocationCallbacks(), &m_Handle);
+    NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkCreateImage");
+
+    // Dedicated, exportable allocation: not through VMA, so the export info can be chained
+    MemoryDesc memoryDesc = {};
+    GetMemoryDesc(memoryLocation, memoryDesc);
+    MemoryTypeInfo memoryTypeInfo = Unpack(memoryDesc.type);
+
+    VkExportMemoryAllocateInfo exportInfo = {VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+    exportInfo.handleTypes = NRI_SHARED_MEMORY_HANDLE_TYPE;
+
+    VkMemoryPriorityAllocateInfoEXT priorityInfo = {VK_STRUCTURE_TYPE_MEMORY_PRIORITY_ALLOCATE_INFO_EXT};
+    priorityInfo.pNext = &exportInfo;
+    priorityInfo.priority = priority * 0.5f + 0.5f;
+
+    VkMemoryDedicatedAllocateInfo dedicatedInfo = {VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+    dedicatedInfo.pNext = m_Device.m_IsSupported.memoryPriority ? (const void*)&priorityInfo : (const void*)&exportInfo;
+    dedicatedInfo.image = m_Handle;
+
+    VkMemoryAllocateInfo memoryInfo = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    memoryInfo.pNext = &dedicatedInfo;
+    memoryInfo.allocationSize = memoryDesc.size;
+    memoryInfo.memoryTypeIndex = memoryTypeInfo.index;
+
+    vkResult = vk.AllocateMemory(m_Device, &memoryInfo, m_Device.GetVkAllocationCallbacks(), &m_SharedMemory);
+    NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkAllocateMemory");
+    m_SharedSize = memoryDesc.size;
+
+    VkBindImageMemoryInfo bindInfo = {VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO};
+    bindInfo.image = m_Handle;
+    bindInfo.memory = m_SharedMemory;
+    bindInfo.memoryOffset = 0;
+
+    vkResult = vk.BindImageMemory2(m_Device, 1, &bindInfo);
+    NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkBindImageMemory2");
+
+    return Result::SUCCESS;
+}
+
+Result TextureVK::GetSharedHandle(SharedHandle& sharedHandle) const {
+    sharedHandle = {};
+    if (!m_SharedMemory)
+        return Result::INVALID_ARGUMENT;
+
+    const auto& vk = m_Device.GetDispatchTable();
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+    VkMemoryGetWin32HandleInfoKHR getInfo = {VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR};
+    getInfo.memory = m_SharedMemory;
+    getInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+
+    HANDLE handle = nullptr;
+    VkResult vkResult = vk.GetMemoryWin32HandleKHR(m_Device, &getInfo, &handle);
+    NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkGetMemoryWin32HandleKHR");
+
+    sharedHandle.handle = handle;
+    sharedHandle.type = SharedHandleType::OPAQUE_WIN32;
+#else
+    VkMemoryGetFdInfoKHR getInfo = {VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR};
+    getInfo.memory = m_SharedMemory;
+    getInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT;
+
+    int fd = -1;
+    VkResult vkResult = vk.GetMemoryFdKHR(m_Device, &getInfo, &fd);
+    NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkGetMemoryFdKHR");
+
+    sharedHandle.handle = (void*)(intptr_t)fd;
+    sharedHandle.type = SharedHandleType::OPAQUE_FD;
+#endif
+    sharedHandle.size = m_SharedSize;
+    sharedHandle.offset = 0;
+
+    return Result::SUCCESS;
+}
