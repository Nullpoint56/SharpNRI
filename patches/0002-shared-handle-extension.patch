+static Result NRI_CALL CreateSharedTexture(Device& device, MemoryLocation memoryLocation, float priority, const TextureDesc& textureDesc, Texture*& texture) {
+    DeviceVal& deviceVal = (DeviceVal&)device;
+    NRI_RETURN_ON_FAILURE(&deviceVal, priority >= -1.0f && priority <= 1.0f, Result::INVALID_ARGUMENT, "'priority' outside of [-1; 1] range");
+    NRI_RETURN_ON_FAILURE(&deviceVal, textureDesc.format > Format::UNKNOWN && textureDesc.format < Format::MAX_NUM, Result::INVALID_ARGUMENT, "'format' is invalid");
+    NRI_RETURN_ON_FAILURE(&deviceVal, textureDesc.width != 0, Result::INVALID_ARGUMENT, "'width' is 0");
+
+    Texture* textureImpl = nullptr;
+    Result result = deviceVal.GetSharedHandleInterfaceImpl().CreateSharedTexture(deviceVal.GetImpl(), memoryLocation, priority, textureDesc, textureImpl);
+
+    texture = nullptr;
+    if (result == Result::SUCCESS)
+        texture = (Texture*)Allocate<TextureVal>(deviceVal.GetAllocationCallbacks(), deviceVal, textureImpl, true);
+
+    return result;
+}
+
+static Result NRI_CALL CreateSharedFence(Device& device, uint64_t initialValue, Fence*& fence) {
+    DeviceVal& deviceVal = (DeviceVal&)device;
+
+    Fence* fenceImpl = nullptr;
+    Result result = deviceVal.GetSharedHandleInterfaceImpl().CreateSharedFence(deviceVal.GetImpl(), initialValue, fenceImpl);
+
+    fence = nullptr;
+    if (result == Result::SUCCESS)
+        fence = (Fence*)Allocate<FenceVal>(deviceVal.GetAllocationCallbacks(), deviceVal, fenceImpl, initialValue == SWAPCHAIN_SEMAPHORE);
+
+    return result;
+}
+
+static Result NRI_CALL GetTextureSharedHandle(const Texture& texture, SharedHandle& sharedHandle) {
+    const TextureVal& textureVal = (const TextureVal&)texture;
+    return textureVal.GetDevice().GetSharedHandleInterfaceImpl().GetTextureSharedHandle(*textureVal.GetImpl(), sharedHandle);
+}
+
+static Result NRI_CALL GetFenceSharedHandle(const Fence& fence, SharedHandle& sharedHandle) {
+    const FenceVal& fenceVal = (const FenceVal&)fence;
+    return fenceVal.GetDevice().GetSharedHandleInterfaceImpl().GetFenceSharedHandle(*fenceVal.GetImpl(), sharedHandle);
+}
+
+Result DeviceVal::FillFunctionTable(SharedHandleInterface& table) const {
+    if (!m_IsExtSupported.sharedHandle)
+        return Result::UNSUPPORTED;
+
+    table.CreateSharedTexture = ::CreateSharedTexture;
+    table.CreateSharedFence = ::CreateSharedFence;
+    table.GetTextureSharedHandle = ::GetTextureSharedHandle;
+    table.GetFenceSharedHandle = ::GetFenceSharedHandle;
