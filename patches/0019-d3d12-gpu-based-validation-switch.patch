D3D12: DeviceCreationDesc::enableD3D12GpuBasedValidation turns on GPU-based validation.

With enableGraphicsAPIValidation, DeviceD3D12::Create enables the debug layer through
ID3D12Debug::EnableDebugLayer before the device is created, but never calls
ID3D12Debug1::SetEnableGPUBasedValidation, which has to happen at the same point (before device
creation, process-global like the debug layer). The CPU-side debug layer doesn't know which
descriptors a shader accesses, so errors such as an uninitialized descriptor in a volatile range are
invisible without it, and a caller can only get it by calling into D3D12 itself before NRI.

This adds enableD3D12GpuBasedValidation to the "disabled by default" switches beside
enableD3D12RayTracingValidation; when set (and only with enableGraphicsAPIValidation), the debug
controller is queried for ID3D12Debug1 after EnableDebugLayer and GPU-based validation is enabled.
Measured on v190 with Agility 1.619, NVIDIA and WARP: a dispatch writing through a PARTIALLY_BOUND
range of two UAVs with only slot 0 written reports "[938] GPU-BASED VALIDATION: Dispatch,
Uninitialized descriptor accessed: ... Descriptor Heap Index FromTableStart: [1]" through
CallbackInterface with the switch, and nothing without it.

diff --git a/Include/Extensions/NRIDeviceCreation.h b/Include/Extensions/NRIDeviceCreation.h
index 7e425e8e..3b37e72e 100644
--- a/Include/Extensions/NRIDeviceCreation.h
+++ b/Include/Extensions/NRIDeviceCreation.h
@@ -89,6 +89,7 @@ NriStruct(DeviceCreationDesc) {
     bool enableGraphicsAPIValidation;           // GAPI-provided validation layer (D3D12: process-global; METAL: ignored, set "MTL_DEBUG_LAYER=1" instead)
     bool enableD3D11CommandBufferEmulation;     // enable? but why? (auto-enabled if deferred contexts are not supported)
     bool enableD3D12RayTracingValidation;       // slow but useful, can only be enabled if envvar "NV_ALLOW_RAYTRACING_VALIDATION" is set to "1"
+    bool enableD3D12GpuBasedValidation;         // D3D12: "ID3D12Debug1::SetEnableGPUBasedValidation" (slow, process-global, requires "enableGraphicsAPIValidation")
     bool enableMemoryZeroInitialization;        // page-clears are fast, but memory is not cleared by default in VK
 
     // Switches (enabled by default)
diff --git a/Source/D3D12/DeviceD3D12.hpp b/Source/D3D12/DeviceD3D12.hpp
index cefd797a..bcdcbd09 100644
--- a/Source/D3D12/DeviceD3D12.hpp
+++ b/Source/D3D12/DeviceD3D12.hpp
@@ -515,8 +515,16 @@ Result DeviceD3D12::Create(const DeviceCreationDesc& desc, const DeviceCreationD
     // IMPORTANT: Must be called before the D3D12 device is created, or the D3D12 runtime removes the device
     if (desc.enableGraphicsAPIValidation) {
         ComPtr<ID3D12Debug> debugController;
-        if (SUCCEEDED(D3D12GetDebugInterface(IID_PPV_ARGS(&debugController))))
+        if (SUCCEEDED(D3D12GetDebugInterface(IID_PPV_ARGS(&debugController)))) {
             debugController->EnableDebugLayer();
+
+            if (desc.enableD3D12GpuBasedValidation) {
+                ComPtr<ID3D12Debug1> debugController1;
+
+                if (SUCCEEDED(debugController->QueryInterface(IID_PPV_ARGS(&debugController1))))
+                    debugController1->SetEnableGPUBasedValidation(true);
+            }
+        }
     }
 
     { // Get adapter
