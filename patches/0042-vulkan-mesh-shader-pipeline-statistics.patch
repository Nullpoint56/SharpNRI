VK: pipeline statistics carry the task and mesh counters only with "features.meshShaderPipelineStats".

QueryPoolVK adds VK_QUERY_PIPELINE_STATISTIC_TASK_SHADER_INVOCATIONS_BIT_EXT and
..._MESH_SHADER_INVOCATIONS_BIT_EXT to every PIPELINE_STATISTICS pool, and sizes each query for 13
counters, when "features.meshShader" is set (QueryPoolVK.hpp:38, :47, :56; since f53490f). Those bits
need VkPhysicalDeviceMeshShaderFeaturesEXT::meshShaderQueries, which DeviceVK reports as
"features.meshShaderPipelineStats" (DeviceVK.hpp:1710) and which a device may lack while having mesh
shaders: vkCreateQueryPool then draws VUID-VkQueryPoolCreateInfo-meshShaderQueries-07069, and the
query size counts two counters the pool does not have. The pool, the query size and a wrapped pool's
query size now follow "features.meshShaderPipelineStats", as NRIDescs.h documents for
"PipelineStatisticsDesc" ("If features.meshShaderPipelineStats").

Measured on main 7ea93bb5, NVIDIA RTX 4070 SUPER, with the Khronos Profiles layer reporting
meshShaderQueries = false (features only) below the validation layer: VUID 07069 at
vkCreateQueryPool and a query size of 104 bytes without the patch; no message and 88 bytes with it.
Devices reporting both features are unchanged.

diff --git a/Source/VK/QueryPoolVK.hpp b/Source/VK/QueryPoolVK.hpp
index 892bf257..6e5b3a6a 100644
--- a/Source/VK/QueryPoolVK.hpp
+++ b/Source/VK/QueryPoolVK.hpp
@@ -35,7 +35,7 @@ Result QueryPoolVK::Create(const QueryPoolDesc& queryPoolDesc) {
         | VK_QUERY_PIPELINE_STATISTIC_TESSELLATION_EVALUATION_SHADER_INVOCATIONS_BIT
         | VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT;
 
-    if (m_Device.GetDesc().features.meshShader)
+    if (m_Device.GetDesc().features.meshShaderPipelineStats)
         pipelineStatistics |= VK_QUERY_PIPELINE_STATISTIC_TASK_SHADER_INVOCATIONS_BIT_EXT | VK_QUERY_PIPELINE_STATISTIC_MESH_SHADER_INVOCATIONS_BIT_EXT;
 
     VkQueryPoolCreateInfo poolInfo = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, nullptr, (VkQueryPoolCreateFlags)0, m_Type, queryPoolDesc.capacity, pipelineStatistics};
@@ -44,7 +44,7 @@ Result QueryPoolVK::Create(const QueryPoolDesc& queryPoolDesc) {
     VkResult vkResult = vk.CreateQueryPool(m_Device, &poolInfo, m_Device.GetVkAllocationCallbacks(), &m_Handle);
     NRI_RETURN_ON_BAD_VKRESULT(&m_Device, vkResult, "vkCreateQueryPool");
 
-    m_QuerySize = (m_Type == VK_QUERY_TYPE_PIPELINE_STATISTICS ? (m_Device.GetDesc().features.meshShader ? 13 : 11) : 1) * sizeof(uint64_t);
+    m_QuerySize = (m_Type == VK_QUERY_TYPE_PIPELINE_STATISTICS ? (m_Device.GetDesc().features.meshShaderPipelineStats ? 13 : 11) : 1) * sizeof(uint64_t);
 
     return Result::SUCCESS;
 }
@@ -53,7 +53,7 @@ Result QueryPoolVK::Create(const QueryPoolVKDesc& queryPoolVKDesc) {
     m_OwnsNativeObjects = false;
     m_Type = (VkQueryType)queryPoolVKDesc.vkQueryType;
     m_Handle = (VkQueryPool)queryPoolVKDesc.vkQueryPool;
-    m_QuerySize = (m_Type == VK_QUERY_TYPE_PIPELINE_STATISTICS ? (m_Device.GetDesc().features.meshShader ? 13 : 11) : 1) * sizeof(uint64_t);
+    m_QuerySize = (m_Type == VK_QUERY_TYPE_PIPELINE_STATISTICS ? (m_Device.GetDesc().features.meshShaderPipelineStats ? 13 : 11) : 1) * sizeof(uint64_t);
 
     return Result::SUCCESS;
 }
