<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591;xUnit1004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- SharedHandleImportTests: the other side of an export, opened with the raw APIs. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>

  <!--
    tools/coverage.ps1 builds with -p:SharpNRICoverage=true and collects test coverage through this
    extension (dotnet test with coverage, cobertura). Off otherwise: Microsoft .NET Library licence,
    test-only, not shipped, and no native collector for osx-arm64 or linux-arm64.
  -->
  <ItemGroup Condition="'$(SharpNRICoverage)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\SharpNRI.csproj" />
    <ProjectReference Include="..\..\descs\SharpNRI.Descs.csproj" />
    <ProjectReference Include="..\..\testing\SharpNRI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Shaders\**" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="RepoRoot" Value="$(MSBuildThisFileDirectory)..\..\" />
  </ItemGroup>

  <!--
    The upscaler tests run locally on -p:SharpNRIDevPayload=upscalers or upscalers-dlss
    (dotnet/SharpNRI.csproj, tools/upscalers.ps1). A later build without it puts Base back, and this
    removes the vendor runtimes that build left here, so a Base run never finds them beside the tests.
  -->
  <Target Name="RemoveDevVendorRuntimes" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SharpNRIDevPayload)' == '' or '$(SharpNRIDevPayload)' == 'base'">
    <ItemGroup>
      <_SharpNRIVendorLeftover Include="$(OutDir)amd_fidelityfx_*.dll;$(OutDir)libxess*.dll;$(OutDir)nvngx_*.dll" />
    </ItemGroup>
    <Delete Files="@(_SharpNRIVendorLeftover)" />
  </Target>

</Project>
