<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591;xUnit1004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- SharedHandleImportTests: the other side of an export, opened with the raw APIs. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>

  <!--
    tools/coverage.ps1 builds with -p:PrismNRICoverage=true and collects test coverage through this
    extension (dotnet test with coverage, cobertura). Off otherwise: Microsoft .NET Library licence,
    test-only, not shipped, and no native collector for osx-arm64 or linux-arm64.
  -->
  <ItemGroup Condition="'$(PrismNRICoverage)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\PrismNRI.csproj" />
    <ProjectReference Include="..\..\descs\PrismNRI.Descs.csproj" />
    <ProjectReference Include="..\..\testing\PrismNRI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Shaders\**" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="RepoRoot" Value="$(MSBuildThisFileDirectory)..\..\" />
  </ItemGroup>

</Project>
