<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpNRI.Descs - NRI's vocabulary as data, with no native dependency.

    Every enum, descriptor struct, function table and opaque handle type the generator emits lives
    here: everything in dotnet/Native except NriApi.cs, which is the only file that names the native
    library. A project that builds pipeline layouts from shader reflection needs
    PipelineLayoutDesc and DescriptorRangeDesc and must not carry NRI.dll to name them. This is the
    assembly it references.

    The split is by file, decided once in ../NativeSplit.props so the two projects cannot disagree
    about where a type lives. SharpNRI references this and adds the imports and the hand-written
    layers on top. One definition of each type.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeSplit.props" />

  <PropertyGroup>
    <RootNamespace>SharpNRI</RootNamespace>
    <PackageId>SharpNRI.Descs</PackageId>
    <Version>$(SharpNRIDescsVersion)</Version>
    <Description>NRI (NVIDIA Render Interface) descriptor structs, enums and function-table layouts as plain .NET types, generated from the pinned NRI headers. No native dependency: reference this to build NRI descriptors without the library. Versioned by NRI: $(NriVersion).x is NRI v$(NriVersion); pin one major.</Description>
    <PackageTags>nri;vulkan;d3d12;rhi;graphics</PackageTags>
    <!-- Trimming and Native AOT: declared (the trim, AOT and single-file analyzers run in every build, as errors in lint) and run by tools/consume's AOT publish -->
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591;CS8981;NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@(SharpNRIGeneratedDesc)" />
    <!-- Hand-written managed forms of the pointer-bearing descs; see NriPipelineLayoutDesc.cs. -->
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
  </ItemGroup>

  <!--
    NriHeaders.Version: the NRI_VERSION the descs were generated from, as a constant (written from
    Directory.Build.props' NriVersion at build time; the AssemblyMetadata below says the same at run time).
  -->
  <Target Name="SharpNRIWriteNriHeaders" BeforeTargets="CoreCompile;BeforeCompile">
    <PropertyGroup>
      <!-- inside the target: IntermediateOutputPath is not set yet where this file's properties are evaluated -->
      <_SharpNRIHeadersFile>$(IntermediateOutputPath)NriHeaders.g.cs</_SharpNRIHeadersFile>
    </PropertyGroup>
    <ItemGroup>
      <_SharpNRIHeadersLine Include="// Generated by SharpNRI.Descs.csproj from Directory.Build.props (NriVersion). Do not edit." />
      <_SharpNRIHeadersLine Include="namespace SharpNRI%3B" />
      <_SharpNRIHeadersLine Include="/// &lt;summary&gt;The NRI headers SharpNRI.Descs was generated from.&lt;/summary&gt;" />
      <_SharpNRIHeadersLine Include="public static class NriHeaders" />
      <_SharpNRIHeadersLine Include="{" />
      <_SharpNRIHeadersLine Include="    /// &lt;summary&gt;NRI_VERSION of the headers: also the major of this package's version. Compiled into the caller.&lt;/summary&gt;" />
      <_SharpNRIHeadersLine Include="    public const int Version = $(NriVersion)%3B" />
      <_SharpNRIHeadersLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SharpNRIHeadersFile)" Lines="@(_SharpNRIHeadersLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_SharpNRIHeadersFile)" />
      <FileWrites Include="$(_SharpNRIHeadersFile)" />
    </ItemGroup>
  </Target>

  <!-- The version's major is the NRI version the descs were generated from (Directory.Build.props: Package versions) -->
  <Target Name="SharpNRIDescsVersionMajor" BeforeTargets="Build;GenerateNuspec" Condition="!$(SharpNRIDescsVersion.StartsWith('$(NriVersion).'))">
    <Error Code="SHARPNRI004" Text="SharpNRIDescsVersion $(SharpNRIDescsVersion) does not start with the NRI version $(NriVersion): a new NRI version starts $(NriVersion).0.0 (Directory.Build.props)" />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="NriVersion" Value="$(NriVersion)" />
    <InternalsVisibleTo Include="SharpNRI" />
    <InternalsVisibleTo Include="SharpNRI.Tests" />
  </ItemGroup>

</Project>
